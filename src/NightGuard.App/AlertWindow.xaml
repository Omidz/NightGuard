<Window x:Class="NightGuard.App.AlertWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="NightGuard" Width="560" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen" ShowInTaskbar="True" Icon="Assets/NightGuard.ico">
    <DockPanel>
        <Border x:Name="Header" DockPanel.Dock="Top" Background="{StaticResource NgIndigo}" Padding="20,14">
            <TextBlock x:Name="TitleText" Foreground="White" FontSize="20" FontWeight="SemiBold" />
        </Border>
        <StackPanel Margin="22,18,22,18">
            <TextBlock x:Name="Body" FontSize="15" TextWrapping="Wrap" LineHeight="22" />
            <Button x:Name="OkButton" Content="Got it" IsDefault="True" IsCancel="True" HorizontalAlignment="Right"
                    MinWidth="110" Margin="0,20,0,0" Padding="16,8" Click="Ok_Click" />
        </StackPanel>
    </DockPanel>
</Window>
