<Window x:Class="NightGuard.App.AlertWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="NightGuard" Width="560" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen" ShowInTaskbar="True" Icon="Assets/NightGuard.ico"
        Background="{StaticResource NgBg}" Foreground="{StaticResource NgText}" UseLayoutRounding="True">
    <DockPanel>
        <Border x:Name="Header" DockPanel.Dock="Top" Padding="20,16">
            <StackPanel Orientation="Horizontal">
                <TextBlock x:Name="HeaderEmoji" FontFamily="Segoe UI Emoji" FontSize="30" Foreground="#FFD666" VerticalAlignment="Center" Margin="0,0,14,0" />
                <TextBlock x:Name="TitleText" Foreground="White" FontSize="22" FontWeight="SemiBold" VerticalAlignment="Center" />
            </StackPanel>
        </Border>
        <StackPanel Margin="22,18,22,18">
            <TextBlock x:Name="Body" FontSize="15" TextWrapping="Wrap" LineHeight="22" />
            <Button x:Name="OkButton" Content="Got it &#x1F44D;" IsDefault="True" IsCancel="True" HorizontalAlignment="Right"
                    MinWidth="110" Margin="0,20,0,0" Click="Ok_Click" Style="{StaticResource MoonButton}" />
        </StackPanel>
    </DockPanel>
</Window>
