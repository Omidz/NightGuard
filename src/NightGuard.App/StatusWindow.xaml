<Window x:Class="NightGuard.App.StatusWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="NightGuard - status and log" Width="860" Height="640" MinWidth="560" MinHeight="400"
        WindowStartupLocation="CenterScreen" Icon="Assets/NightGuard.ico">
    <DockPanel Margin="16">
        <DockPanel DockPanel.Dock="Bottom" Margin="0,12,0,0">
            <Button Content="Refresh" Padding="14,6" Click="Refresh_Click" DockPanel.Dock="Left" />
            <Button Content="Close" IsCancel="True" Padding="14,6" MinWidth="90" HorizontalAlignment="Right" Click="Close_Click" />
        </DockPanel>
        <TextBox x:Name="Text" IsReadOnly="True" FontFamily="Consolas" FontSize="13" TextWrapping="NoWrap"
                 VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" />
    </DockPanel>
</Window>
