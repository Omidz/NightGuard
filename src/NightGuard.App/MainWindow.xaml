<Window x:Class="NightGuard.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:NightGuard.App"
        Title="NightGuard" Width="1180" Height="800" MinWidth="720" MinHeight="560"
        WindowStartupLocation="CenterScreen" Icon="Assets/NightGuard.ico"
        Background="{StaticResource NgBg}" Foreground="{StaticResource NgText}" UseLayoutRounding="True">
    <Window.Resources>
        <Style x:Key="PageBody" TargetType="StackPanel">
            <Setter Property="Margin" Value="40,32,40,40" />
            <Setter Property="MaxWidth" Value="1040" />
        </Style>
        <Style x:Key="PageScroll" TargetType="ScrollViewer">
            <Setter Property="VerticalScrollBarVisibility" Value="Auto" />
            <Setter Property="HorizontalScrollBarVisibility" Value="Disabled" />
            <Setter Property="Visibility" Value="Collapsed" />
        </Style>
        <Style x:Key="StepEmoji" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource NgEmoji}" />
            <Setter Property="FontSize" Value="18" />
            <Setter Property="Width" Value="32" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style x:Key="StepLabel" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        </Style>
    </Window.Resources>

    <Grid x:Name="Root">
        <Grid.ColumnDefinitions>
            <ColumnDefinition x:Name="SideColumn" Width="252" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- ============================================================ sidebar -->
        <Border Grid.Column="0" Background="{StaticResource NgSidebar}" BorderBrush="{StaticResource NgStroke}" BorderThickness="0,0,2,0">
            <DockPanel Margin="12,18,12,14">
                <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="4,0,0,20">
                    <local:Owl Width="46" Height="50" Bob="False" />
                    <StackPanel x:Name="BrandText" VerticalAlignment="Center" Margin="10,0,0,0">
                        <TextBlock Text="NightGuard" FontFamily="{StaticResource NgDisplay}" FontSize="22" FontWeight="Bold" />
                        <TextBlock Text="your bedtime bouncer" FontSize="12.5" Foreground="{StaticResource NgMoon}" />
                    </StackPanel>
                </StackPanel>
                <StackPanel DockPanel.Dock="Bottom">
                    <Separator Margin="4,6,4,8" Background="{StaticResource NgStroke}" />
                    <Button x:Name="JournalButton" Style="{StaticResource SideButton}" Click="Journal_Click" ToolTip="My journal">
                        <StackPanel Orientation="Horizontal"><TextBlock Text="📓" Style="{StaticResource StepEmoji}" /><TextBlock Text="My journal" Style="{StaticResource StepLabel}" Tag="label" /></StackPanel>
                    </Button>
                    <Button x:Name="StatusButton" Style="{StaticResource SideButton}" Click="Status_Click" ToolTip="Status and log">
                        <StackPanel Orientation="Horizontal"><TextBlock Text="📊" Style="{StaticResource StepEmoji}" /><TextBlock Text="Status and log" Style="{StaticResource StepLabel}" Tag="label" /></StackPanel>
                    </Button>
                    <Button x:Name="DiscardButton" Style="{StaticResource SideButton}" Click="Discard_Click" ToolTip="Discard changes">
                        <StackPanel Orientation="Horizontal"><TextBlock Text="↩️" Style="{StaticResource StepEmoji}" /><TextBlock Text="Discard changes" Style="{StaticResource StepLabel}" Tag="label" /></StackPanel>
                    </Button>
                    <Button x:Name="UninstallButton" Style="{StaticResource SideButton}" Click="Uninstall_Click" ToolTip="Uninstall">
                        <StackPanel Orientation="Horizontal"><TextBlock Text="🚪" Style="{StaticResource StepEmoji}" /><TextBlock x:Name="UninstallText" Text="Request uninstall..." Style="{StaticResource StepLabel}" Tag="label" /></StackPanel>
                    </Button>
                </StackPanel>
                <ListBox x:Name="Steps" SelectionChanged="Steps_SelectionChanged" BorderThickness="0" Background="Transparent"
                         ItemContainerStyle="{StaticResource StepItem}" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListBoxItem ToolTip="Welcome"><StackPanel Orientation="Horizontal"><TextBlock Text="👋" Style="{StaticResource StepEmoji}" /><TextBlock x:Name="WelcomeStepText" Text="Welcome" Style="{StaticResource StepLabel}" Tag="label" /></StackPanel></ListBoxItem>
                    <ListBoxItem ToolTip="Your why"><StackPanel Orientation="Horizontal"><TextBlock Text="💬" Style="{StaticResource StepEmoji}" /><TextBlock Text="Your why" Style="{StaticResource StepLabel}" Tag="label" /></StackPanel></ListBoxItem>
                    <ListBoxItem ToolTip="Bedtimes"><StackPanel Orientation="Horizontal"><TextBlock Text="🛏️" Style="{StaticResource StepEmoji}" /><TextBlock Text="Bedtimes" Style="{StaticResource StepLabel}" Tag="label" /></StackPanel></ListBoxItem>
                    <ListBoxItem ToolTip="Warnings"><StackPanel Orientation="Horizontal"><TextBlock Text="⏰" Style="{StaticResource StepEmoji}" /><TextBlock Text="Warnings" Style="{StaticResource StepLabel}" Tag="label" /></StackPanel></ListBoxItem>
                    <ListBoxItem ToolTip="At bedtime"><StackPanel Orientation="Horizontal"><TextBlock Text="🌙" Style="{StaticResource StepEmoji}" /><TextBlock Text="At bedtime" Style="{StaticResource StepLabel}" Tag="label" /></StackPanel></ListBoxItem>
                    <ListBoxItem ToolTip="Game and screen time"><StackPanel Orientation="Horizontal"><TextBlock Text="🎮" Style="{StaticResource StepEmoji}" /><TextBlock Text="Game and screen time" Style="{StaticResource StepLabel}" Tag="label" /></StackPanel></ListBoxItem>
                    <ListBoxItem ToolTip="Block sites and apps"><StackPanel Orientation="Horizontal"><TextBlock Text="🚫" Style="{StaticResource StepEmoji}" /><TextBlock Text="Block sites and apps" Style="{StaticResource StepLabel}" Tag="label" /></StackPanel></ListBoxItem>
                    <ListBoxItem ToolTip="Trusted person"><StackPanel Orientation="Horizontal"><TextBlock Text="🔐" Style="{StaticResource StepEmoji}" /><TextBlock Text="Trusted person" Style="{StaticResource StepLabel}" Tag="label" /></StackPanel></ListBoxItem>
                    <ListBoxItem ToolTip="Review"><StackPanel Orientation="Horizontal"><TextBlock Text="✅" Style="{StaticResource StepEmoji}" /><TextBlock Text="Review" Style="{StaticResource StepLabel}" Tag="label" /></StackPanel></ListBoxItem>
                </ListBox>
            </DockPanel>
        </Border>

        <!-- ============================================================ content -->
        <DockPanel Grid.Column="1">
            <!-- Service / account banner -->
            <Border x:Name="Banner" DockPanel.Dock="Top" Visibility="Collapsed" Padding="22,12" Background="{StaticResource NgIndigo}">
                <DockPanel>
                    <Button x:Name="BannerButton" DockPanel.Dock="Right" Margin="12,0,0,0" Click="BannerButton_Click" Style="{StaticResource ChunkyButton}" Padding="14,6" />
                    <TextBlock x:Name="BannerText" Foreground="White" TextWrapping="Wrap" VerticalAlignment="Center" FontSize="13.5" />
                </DockPanel>
            </Border>

            <!-- Back / Next / Start -->
            <Border DockPanel.Dock="Bottom" Background="{StaticResource NgSidebar}" BorderBrush="{StaticResource NgStroke}" BorderThickness="0,2,0,0" Padding="24,12">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button x:Name="BackButton" Content="Back" MinWidth="90" Margin="0,0,10,0" Click="Back_Click" Style="{StaticResource ChunkyButton}" />
                        <Button x:Name="NextButton" Content="Next" MinWidth="150" Click="Next_Click" Style="{StaticResource MoonButton}" />
                        <Button x:Name="SaveButton" Content="Start NightGuard" MinWidth="170" Click="Save_Click" Visibility="Collapsed" Style="{StaticResource MoonButton}" />
                    </StackPanel>
                    <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
                        <ProgressBar x:Name="StepProgress" Height="6" Maximum="8" Margin="0,0,0,6" MaxWidth="320" HorizontalAlignment="Left" Width="320" />
                        <TextBlock x:Name="BottomHint" TextWrapping="Wrap" FontSize="13" Foreground="{StaticResource NgMuted}" />
                    </StackPanel>
                </DockPanel>
            </Border>

            <Grid x:Name="Pages">

                <!-- 0. Welcome / home -->
                <ScrollViewer x:Name="PageWelcome" Style="{StaticResource PageScroll}" Visibility="Visible">
                    <StackPanel Style="{StaticResource PageBody}">
                        <local:NightScene x:Name="Scene" Headline="Hi there, night owl!" Tagline="Let's get you to bed on time. Future you is already grateful." />

                        <!-- First run -->
                        <StackPanel x:Name="NewUserPanel">
                            <TextBlock Style="{StaticResource Lead}" FontSize="16"
                                       Text="NightGuard is your bedtime bouncer. You tell it when you want to be in bed, and it makes sure your PC agrees with you. No more &quot;one more match&quot; at 2 AM. Setup takes about five minutes, and nothing starts until the very last step." />
                            <TextBlock Text="How it works" Style="{StaticResource H2}" Margin="0,4,0,12" />
                            <WrapPanel x:Name="HowItWorks" />
                            <Border Style="{StaticResource DangerCard}" Margin="0,8,0,0">
                                <DockPanel>
                                    <TextBlock DockPanel.Dock="Left" Text="⚠️" FontFamily="{StaticResource NgEmoji}" FontSize="24" Margin="0,0,14,0" VerticalAlignment="Top" />
                                    <TextBlock TextWrapping="Wrap" LineHeight="21" FontSize="14">
                                        <Run FontWeight="Bold" Text="Before you start:" />
                                        <Run Text="NightGuard really does shut down, hibernate and lock this PC. It comes with no warranty, and you use it at your own risk, so save your work when the warnings pop up." />
                                    </TextBlock>
                                </DockPanel>
                            </Border>
                        </StackPanel>

                        <!-- Home, once it's running -->
                        <StackPanel x:Name="HomePanel" Visibility="Collapsed">
                            <Border x:Name="CommitDoneCard" Style="{StaticResource Card}" BorderBrush="{StaticResource NgMoon}" Visibility="Collapsed">
                                <DockPanel>
                                    <local:Owl DockPanel.Dock="Left" Mood="Happy" Width="80" Height="86" Margin="0,0,18,0" />
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock x:Name="CommitDoneTitle" Style="{StaticResource SerifTitle}" FontSize="28" />
                                        <TextBlock x:Name="CommitDoneText" Style="{StaticResource Hint}" FontSize="14" Margin="0,4,0,12" />
                                        <WrapPanel>
                                            <Button Content="🎯  Commit again" Style="{StaticResource MoonButton}" Click="CommitAgain_Click" Margin="0,0,10,0" />
                                            <Button Content="🎉  Celebrate first" Style="{StaticResource ChunkyButton}" Click="Celebrate_Click" />
                                        </WrapPanel>
                                    </StackPanel>
                                </DockPanel>
                            </Border>
                            <WrapPanel x:Name="HomeTiles">
                                <Border Style="{StaticResource TileCard}" Width="256">
                                    <StackPanel>
                                        <TextBlock Text="TONIGHT" Style="{StaticResource Overline}" />
                                        <TextBlock x:Name="TonightBig" FontFamily="{StaticResource NgDisplay}" FontSize="30" FontWeight="Bold" TextWrapping="Wrap" />
                                        <TextBlock x:Name="TonightText" Style="{StaticResource Hint}" />
                                    </StackPanel>
                                </Border>
                                <Border Style="{StaticResource TileCard}" Width="256">
                                    <StackPanel>
                                        <TextBlock Text="STREAK" Style="{StaticResource Overline}" />
                                        <TextBlock x:Name="StreakBig" FontFamily="{StaticResource NgDisplay}" FontSize="30" FontWeight="Bold" />
                                        <TextBlock x:Name="StreakText" Style="{StaticResource Hint}" />
                                    </StackPanel>
                                </Border>
                                <Border Style="{StaticResource TileCard}" Width="256">
                                    <DockPanel>
                                        <Grid DockPanel.Dock="Right" Width="76" Height="76" Margin="10,0,0,0">
                                            <local:RingArc x:Name="CommitRing" Thickness="9" />
                                            <TextBlock x:Name="CommitRingText" HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="Bold" FontSize="16" />
                                        </Grid>
                                        <StackPanel>
                                            <TextBlock Text="COMMITMENT" Style="{StaticResource Overline}" />
                                            <TextBlock x:Name="CommitBig" FontFamily="{StaticResource NgDisplay}" FontSize="22" FontWeight="Bold" TextWrapping="Wrap" />
                                            <TextBlock x:Name="CommitText" Style="{StaticResource Hint}" />
                                        </StackPanel>
                                    </DockPanel>
                                </Border>
                            </WrapPanel>
                            <Border Style="{StaticResource Card}" Background="{StaticResource NgSkyBrush}">
                                <StackPanel>
                                    <DockPanel>
                                        <Button DockPanel.Dock="Right" Content="Edit" Style="{StaticResource LinkButton}" Click="EditWhy_Click" VerticalAlignment="Top" />
                                        <TextBlock Text="YOUR WHY" Style="{StaticResource Overline}" />
                                    </DockPanel>
                                    <TextBlock x:Name="HomeWhy" Style="{StaticResource SerifQuote}" FontSize="24" LineHeight="33" Margin="0,4,0,0" />
                                    <TextBlock x:Name="HomePlan" Style="{StaticResource Hint}" FontSize="14" Margin="0,10,0,0" />
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource Card}">
                                <TextBlock x:Name="StatusCardText" TextWrapping="Wrap" FontSize="14" LineHeight="22" />
                            </Border>
                            <WrapPanel>
                                <Button Content="⚙️  Change settings" Style="{StaticResource MoonButton}" Click="Next_Click" Margin="0,0,10,10" />
                                <Button Content="📓  My journal" Style="{StaticResource ChunkyButton}" Click="Journal_Click" Margin="0,0,10,10" />
                            </WrapPanel>
                            <TextBlock x:Name="WelcomeText" Style="{StaticResource Hint}" Margin="0,8,0,0" />
                        </StackPanel>
                        <Border x:Name="StandDownCard" Style="{StaticResource DangerCard}" Visibility="Collapsed">
                            <TextBlock x:Name="StandDownText" TextWrapping="Wrap" FontSize="14" />
                        </Border>
                    </StackPanel>
                </ScrollViewer>

                <!-- 1. Your why: the ritual -->
                <ScrollViewer x:Name="PageWhy" Style="{StaticResource PageScroll}" Background="{StaticResource NgSkyBrush}">
                    <Grid>
                        <Canvas x:Name="WhySky" IsHitTestVisible="False" ClipToBounds="True" />
                        <StackPanel Style="{StaticResource PageBody}" MaxWidth="900">
                            <DockPanel Margin="0,0,0,22">
                                <local:Owl DockPanel.Dock="Left" Width="92" Height="100" Margin="0,0,20,0" VerticalAlignment="Center" />
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock x:Name="WhyStep" Style="{StaticResource Overline}" />
                                    <TextBlock Text="Why do you want your nights back?" Style="{StaticResource SerifTitle}" FontSize="38" />
                                    <TextBlock Style="{StaticResource Lead}" Margin="0,8,0,0" Text="Take a quiet minute. This is the part that makes the rest work." />
                                </StackPanel>
                            </DockPanel>

                            <Border Style="{StaticResource Card}" Background="#33181D45">
                                <StackPanel>
                                    <TextBlock Text="THE 60-SECOND RITUAL" Style="{StaticResource Overline}" />
                                    <WrapPanel x:Name="RitualSteps" Margin="0,8,0,0" />
                                    <TextBlock Style="{StaticResource Hint}" FontSize="12" Margin="0,6,0,0"
                                               Text="Why it works: goals tied to your own values are the ones people stick with. If-then plans make people much more likely to follow through (a review of 94 studies, Gollwitzer and Sheeran, 2006). Writing down three good things lifts mood for months (Seligman and colleagues, 2005)." />
                                </StackPanel>
                            </Border>

                            <TextBlock Text="① My why" Style="{StaticResource H2}" Margin="0,10,0,10" />
                            <TextBox x:Name="WhyBox" Style="{StaticResource JournalBox}" MaxLength="300" AcceptsReturn="False" MinHeight="90"
                                     Tag="I want to... (one sentence about what you'll gain)" TextChanged="WhyBox_TextChanged" />
                            <TextBlock x:Name="WhyCount" Style="{StaticResource Hint}" HorizontalAlignment="Right" />
                            <TextBlock Text="Stuck? Borrow one:" Style="{StaticResource Hint}" Margin="0,4,0,8" />
                            <WrapPanel x:Name="WhyIdeas" />

                            <TextBlock Text="② My plan for the final call" Style="{StaticResource H2}" Margin="0,22,0,6" />
                            <TextBlock Text="When the final call pops up, I will..." FontFamily="{StaticResource NgSerifText}" FontSize="18" FontStyle="Italic" Foreground="{StaticResource NgMuted}" Margin="0,0,0,10" />
                            <TextBox x:Name="PlanBox" Style="{StaticResource JournalBox}" MaxLength="200" AcceptsReturn="False"
                                     Tag="save, say gg, and stand up" TextChanged="WhyBox_TextChanged" />
                            <WrapPanel x:Name="PlanIdeas" Margin="0,10,0,0" />

                            <Border Style="{StaticResource Card}" Background="#33181D45" Margin="0,22,0,0">
                                <StackPanel>
                                    <CheckBox x:Name="CheckInCheck" Style="{StaticResource ToggleSwitch}" FontWeight="SemiBold" FontSize="15"
                                              Content="③ Morning check-in: mood, three good things, streaks and badges" />
                                    <TextBlock Style="{StaticResource Hint}" Margin="58,6,0,0" Text="Two minutes on your first sign-in each day. A little cheer for last night, your streak of clean nights, and a private journal you can read back any time. Skip it with one click." />
                                </StackPanel>
                            </Border>

                            <TextBlock Text="✦     ✦     ✦" HorizontalAlignment="Center" Foreground="{StaticResource NgMoon}" FontSize="16" Margin="0,18,0,18" />

                            <TextBlock Text="I commit to..." Style="{StaticResource SerifTitle}" />
                            <TextBlock Style="{StaticResource Lead}" Margin="0,6,0,16" Text="Pick how many nights you're in for. It's a promise to yourself, not a lock: when you get there, NightGuard throws you a party and asks if you want to go again." />
                            <WrapPanel x:Name="CommitChoices" />
                            <ToggleButton x:Name="ForeverCard" Style="{StaticResource ChoiceCard}" Margin="0,0,0,14" Padding="24,18" Click="CommitChoice_Click" Tag="0">
                                <ToggleButton.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                        <GradientStop Color="#2A2466" Offset="0" />
                                        <GradientStop Color="#5A3E9E" Offset="0.7" />
                                        <GradientStop Color="#8A4FA0" Offset="1" />
                                    </LinearGradientBrush>
                                </ToggleButton.Background>
                                <DockPanel>
                                    <local:Owl DockPanel.Dock="Right" Mood="Happy" Width="84" Height="92" Margin="12,0,30,0" />
                                    <TextBlock DockPanel.Dock="Left" Text="∞" FontSize="78" FontWeight="Bold" Foreground="{StaticResource NgMoon}" VerticalAlignment="Center" Margin="0,-14,22,0" />
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="Forever" FontFamily="{StaticResource NgSerif}" FontSize="36" Foreground="White" />
                                        <TextBlock Text="No finish line. Just your new normal. 🌙" FontSize="15" Foreground="#E6FFFFFF" TextWrapping="Wrap" />
                                    </StackPanel>
                                </DockPanel>
                            </ToggleButton>
                            <local:HoldButton x:Name="SignButton" Margin="0,6,0,8" />
                            <TextBlock x:Name="CommitStateText" Style="{StaticResource Hint}" />
                        </StackPanel>
                    </Grid>
                </ScrollViewer>

                <!-- 2. Bedtimes -->
                <ScrollViewer x:Name="PageBedtimes" Style="{StaticResource PageScroll}">
                    <StackPanel Style="{StaticResource PageBody}">
                        <local:PageHeader x:Name="HeadBedtimes" Emoji="🛏️" EmojiColor="#C9D2FF" Title="Bedtimes" Subtitle="Pick when the bouncer starts its shift. Each night is named after the evening it starts, so a 12:30 AM bedtime on Monday night means early Tuesday." />
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Text="Quick set" Style="{StaticResource H2}" />
                                <WrapPanel>
                                    <StackPanel Margin="0,0,24,12">
                                        <TextBlock Text="Bedtime" Style="{StaticResource Hint}" Margin="0,0,0,6" />
                                        <local:TimePicker x:Name="QuickBed" />
                                    </StackPanel>
                                    <StackPanel Margin="0,0,24,12">
                                        <TextBlock Text="Unlocks at" Style="{StaticResource Hint}" Margin="0,0,0,6" />
                                        <local:TimePicker x:Name="QuickUnlock" />
                                    </StackPanel>
                                    <WrapPanel VerticalAlignment="Bottom" Margin="0,0,0,12">
                                        <Button Content="Every night" Style="{StaticResource ChunkyButton}" Margin="0,0,8,0" Click="QuickAll_Click" />
                                        <Button Content="Sun to Thu" Style="{StaticResource ChunkyButton}" Margin="0,0,8,0" Click="QuickWeek_Click" />
                                        <Button Content="Fri and Sat" Style="{StaticResource ChunkyButton}" Click="QuickWeekend_Click" />
                                    </WrapPanel>
                                </WrapPanel>
                                <TextBlock x:Name="TimeHintText" Style="{StaticResource Hint}" />
                            </StackPanel>
                        </Border>
                        <WrapPanel x:Name="NightsPanel" />
                        <TextBlock Style="{StaticResource Hint}" Margin="0,8,0,0" Text="Safety limits: a night can be at most 16 hours, and there must be at least 6 free hours between nights. NightGuard wants you asleep, not locked out of your own day." />
                    </StackPanel>
                </ScrollViewer>

                <!-- 3. Warnings -->
                <ScrollViewer x:Name="PageWarnings" Style="{StaticResource PageScroll}">
                    <StackPanel Style="{StaticResource PageBody}">
                        <local:PageHeader x:Name="HeadWarnings" Emoji="⏰" EmojiColor="#FFD0B0" Title="Warnings" Subtitle="Friendly nudges first. Then less friendly ones. Switch on the ones you want, and pick when they pop up." />
                        <WrapPanel x:Name="WarningsPanel" />
                        <Border Style="{StaticResource Card}">
                            <DockPanel>
                                <Button DockPanel.Dock="Right" Content="👀  Preview the countdown" Style="{StaticResource ChunkyButton}" Click="PreviewCountdown_Click" VerticalAlignment="Center" Margin="16,0,0,0" />
                                <StackPanel>
                                    <TextBlock Text="Then, at bedtime: the countdown" Style="{StaticResource H2}" />
                                    <TextBlock Style="{StaticResource Hint}" Text="The last thing you see before the PC does its thing, with your why on it. You set its length on the next step." />
                                </StackPanel>
                            </DockPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>

                <!-- 4. At bedtime -->
                <ScrollViewer x:Name="PageAction" Style="{StaticResource PageScroll}">
                    <StackPanel Style="{StaticResource PageBody}">
                        <local:PageHeader x:Name="HeadAction" Emoji="🌙" EmojiColor="#E0D0FF" Title="At bedtime" Subtitle="Bedtime has arrived. Your game disagrees. Here's how NightGuard settles the argument." />
                        <TextBlock Text="When time's up, the PC will..." Style="{StaticResource H2}" Margin="0,0,0,12" />
                        <WrapPanel x:Name="ActionsPanel" />
                        <TextBlock Text="Last call before it happens" Style="{StaticResource H2}" Margin="0,12,0,4" />
                        <TextBlock Style="{StaticResource Hint}" Margin="0,0,0,10" Text="A full-screen countdown, even over your game, with a button to skip the wait." />
                        <local:PillPicker x:Name="CountdownPills" />
                        <Expander Header="More options" Margin="0,18,0,0" FontSize="14">
                            <StackPanel Margin="4,12,0,4">
                                <TextBlock Text="Switched the PC back on at night? Do it again every" Style="{StaticResource Label}" />
                                <local:PillPicker x:Name="RecheckPills" />
                                <TextBlock Text="Lock NightGuard's settings this long before bedtime (night mode)" Style="{StaticResource Label}" Margin="0,14,0,8" />
                                <local:PillPicker x:Name="NightModePills" />
                                <TextBlock Style="{StaticResource Hint}" Text="Night mode stops tired-you from loosening the rules at 11:58 PM. It lasts until the PC unlocks in the morning." />
                            </StackPanel>
                        </Expander>
                        <Border x:Name="LegacyEndCard" Style="{StaticResource Card}" Margin="0,20,0,0" Visibility="Collapsed">
                            <TextBlock x:Name="LegacyEndText" TextWrapping="Wrap" FontSize="14" />
                        </Border>
                    </StackPanel>
                </ScrollViewer>

                <!-- 5. Game and screen time -->
                <ScrollViewer x:Name="PageScreen" Style="{StaticResource PageScroll}">
                    <StackPanel Style="{StaticResource PageBody}">
                        <local:PageHeader x:Name="HeadScreen" Emoji="🎮" EmojiColor="#C8F2C8" Title="Game and screen time" Subtitle="&quot;Just one more game&quot; now comes with a budget. Optional." />
                        <TextBlock Style="{StaticResource Lead}" Text="Pick one, both or neither. Each has its own switch." />

                        <!-- Game time -->
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <CheckBox x:Name="GameLimitCheck" Style="{StaticResource ToggleSwitch}" Content="🎮 Game time budget" FontWeight="SemiBold" FontSize="16"
                                          Checked="Section_Changed" Unchecked="Section_Changed" />
                                <TextBlock Style="{StaticResource Hint}" Margin="58,4,0,0" Text="Counts while a game runs. When it's used up, games close (and close again if you reopen them)." />
                                <StackPanel x:Name="GameBody" Margin="0,16,0,0">
                                    <WrapPanel>
                                        <Border Style="{StaticResource TileCard}" Width="250"><StackPanel><TextBlock Text="Weekdays" Style="{StaticResource Label}" /><local:IntBox x:Name="GameWd" Min="0" Max="1440" Step="15" Suffix="min" /></StackPanel></Border>
                                        <Border Style="{StaticResource TileCard}" Width="250"><StackPanel><TextBlock Text="Weekends" Style="{StaticResource Label}" /><local:IntBox x:Name="GameWe" Min="0" Max="1440" Step="15" Suffix="min" /></StackPanel></Border>
                                    </WrapPanel>
                                    <TextBlock Style="{StaticResource Hint}" Margin="0,0,0,10" Text="0 means no game limit on those days." />
                                    <CheckBox x:Name="LaunchersCheck" Style="{StaticResource ToggleSwitch}" Content="Also close game launchers (Steam, Epic...)" Margin="0,0,0,8" />
                                    <Expander Header="Fine-tune what counts as a game" FontSize="14" Margin="0,8,0,0">
                                        <StackPanel Margin="4,12,0,4">
                                            <TextBlock Style="{StaticResource Hint}" Margin="0,0,0,12" Text="Anything running from a game folder counts as a game. Program names are as in Task Manager > Details (no .exe needed). Windows' own programs are never closed." />
                                            <TextBlock Text="📁 Game folders" Style="{StaticResource H2}" Margin="0,0,0,6" />
                                            <local:ListEditor x:Name="GameFoldersEditor" IsPath="True" Placeholder="Paste a folder path, or browse" MaxListHeight="220" />
                                            <UniformGrid Columns="3" Margin="0,18,0,0">
                                                <StackPanel Margin="0,0,12,0"><TextBlock Text="🎮 Extra games" Style="{StaticResource H2}" Margin="0,0,0,6" /><local:ListEditor x:Name="GameProcsEditor" Emoji="🎮" Placeholder="e.g. cs2" MaxListHeight="200" /></StackPanel>
                                                <StackPanel Margin="0,0,12,0"><TextBlock Text="🙈 Never count" Style="{StaticResource H2}" Margin="0,0,0,6" /><local:ListEditor x:Name="IgnoreProcsEditor" Emoji="🙈" Placeholder="e.g. Spotify" MaxListHeight="200" /></StackPanel>
                                                <StackPanel><TextBlock Text="🚀 Launchers" Style="{StaticResource H2}" Margin="0,0,0,6" /><local:ListEditor x:Name="LauncherProcsEditor" Emoji="🚀" Placeholder="e.g. steam" MaxListHeight="200" /></StackPanel>
                                            </UniformGrid>
                                        </StackPanel>
                                    </Expander>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <!-- Screen time -->
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <CheckBox x:Name="ScreenLimitCheck" Style="{StaticResource ToggleSwitch}" Content="🖥️ Screen time budget" FontWeight="SemiBold" FontSize="16"
                                          Checked="Section_Changed" Unchecked="Section_Changed" />
                                <TextBlock Style="{StaticResource Hint}" Margin="58,4,0,0" Text="Counts every minute you're signed in and the screen isn't locked." />
                                <StackPanel x:Name="ScreenLimitBody" Margin="0,16,0,0">
                                    <WrapPanel>
                                        <Border Style="{StaticResource TileCard}" Width="250"><StackPanel><TextBlock Text="Weekdays" Style="{StaticResource Label}" /><local:IntBox x:Name="ScreenWd" Min="0" Max="1440" Step="15" Suffix="min" /></StackPanel></Border>
                                        <Border Style="{StaticResource TileCard}" Width="250"><StackPanel><TextBlock Text="Weekends" Style="{StaticResource Label}" /><local:IntBox x:Name="ScreenWe" Min="0" Max="1440" Step="15" Suffix="min" /></StackPanel></Border>
                                    </WrapPanel>
                                    <TextBlock Style="{StaticResource Hint}" Margin="0,0,0,10" Text="0 means no screen limit on those days. The smallest limit is 30 minutes." />
                                    <TextBlock Text="When it runs out" Style="{StaticResource Label}" />
                                    <local:PillPicker x:Name="LimitPills" />
                                    <StackPanel x:Name="GracePanel" Orientation="Horizontal" Margin="0,6,0,0">
                                        <TextBlock Text="Shutdown notice" VerticalAlignment="Center" Margin="0,0,12,0" />
                                        <local:IntBox x:Name="GraceBox" Min="1" Max="10" Suffix="min" />
                                    </StackPanel>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <!-- Shared by both -->
                        <Border x:Name="SharedScreenCard" Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Text="Warn me when this much is left" Style="{StaticResource Label}" Margin="0,0,0,8" />
                                <local:MultiPills x:Name="WarnAtPills" />
                                <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                                    <TextBlock Text="A new day starts at" VerticalAlignment="Center" Margin="0,0,12,0" />
                                    <local:IntBox x:Name="ResetHour" Min="0" Max="23" Suffix=":00" />
                                </StackPanel>
                                <TextBlock x:Name="UsageText" Style="{StaticResource Hint}" Margin="0,10,0,0" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>

                <!-- 6. Block sites and apps -->
                <ScrollViewer x:Name="PageBlock" Style="{StaticResource PageScroll}">
                    <StackPanel Style="{StaticResource PageBody}">
                        <local:PageHeader x:Name="HeadBlock" Emoji="🚫" EmojiColor="#FFC2C2" Title="Block sites and apps" Subtitle="Goodbye, 1 AM doomscrolling. Optional." />
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <CheckBox x:Name="BlockCheck" Style="{StaticResource ToggleSwitch}" Content="Block sites and apps" FontWeight="SemiBold" FontSize="16"
                                          Checked="Section_Changed" Unchecked="Section_Changed" />
                                <CheckBox x:Name="BlockBedtimeCheck" Style="{StaticResource ToggleSwitch}" Content="During bedtime hours" Margin="0,14,0,0" />
                            </StackPanel>
                        </Border>
                        <StackPanel x:Name="BlockBody">
                            <Border Style="{StaticResource Card}">
                                <StackPanel>
                                    <DockPanel Margin="0,0,0,8">
                                        <Button DockPanel.Dock="Right" Content="+ Social media list" Style="{StaticResource Chip}" Click="SocialPreset_Click" Margin="0" />
                                        <TextBlock Text="🌐 Websites" Style="{StaticResource H2}" />
                                    </DockPanel>
                                    <local:ListEditor x:Name="SitesEditor" Emoji="🌐" Placeholder="Add a site, like reddit.com" EmptyText="No sites yet." MaxListHeight="260" />
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource Card}">
                                <StackPanel>
                                    <TextBlock Text="📦 Apps (their internet is cut, they aren't closed)" Style="{StaticResource H2}" />
                                    <local:ListEditor x:Name="AppsEditor" IsPath="True" AllowTyping="False" EmptyText="No apps yet. Add a program, or a whole folder like Steam or Discord." MaxListHeight="240" Margin="0,4,0,0" />
                                </StackPanel>
                            </Border>
                            <TextBlock Text="⏱️ Also block at these times" Style="{StaticResource H2}" Margin="0,6,0,4" />
                            <TextBlock Style="{StaticResource Hint}" Margin="0,0,0,12" Text="A slot like 10 PM to 2 AM crosses midnight." />
                            <WrapPanel x:Name="SlotsPanel" />
                            <TextBlock Style="{StaticResource Hint}" Text="Sites are blocked in a marked section of the Windows hosts file; apps with Windows Firewall rules named 'NightGuard'. Both are removed automatically when the time slot ends, on uninstall, and if anything goes wrong. Browsers with 'secure DNS' turned on can get around site blocking (see the README)." />
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>

                <!-- 7. Trusted person -->
                <ScrollViewer x:Name="PageTrusted" Style="{StaticResource PageScroll}">
                    <StackPanel Style="{StaticResource PageBody}">
                        <local:PageHeader x:Name="HeadTrusted" Emoji="🔐" EmojiColor="#FFE9A8" Title="Trusted person" Subtitle="Know yourself too well? Hand the off switch to someone else. Optional." />
                        <TextBlock Style="{StaticResource Lead}" Text="A trusted person (parent, partner, friend, the roommate who's tired of hearing you game at 3 AM) sets a secret 8-digit code. After that, changing settings or uninstalling needs their code." />
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <CheckBox x:Name="TrustCheck" Style="{StaticResource ToggleSwitch}" Content="Use a trusted-person code" FontWeight="SemiBold" FontSize="16" Checked="TrustCheck_Changed" Unchecked="TrustCheck_Changed" />
                                <TextBlock x:Name="TrustState" TextWrapping="Wrap" Margin="0,12,0,0" FontSize="14" />
                                <TextBlock Text="Their name (optional)" Style="{StaticResource Label}" Margin="0,16,0,6" />
                                <TextBox x:Name="ContactBox" MaxWidth="360" HorizontalAlignment="Left" Width="360" MaxLength="60" />
                                <WrapPanel Margin="0,16,0,0">
                                    <Button x:Name="ChangeCodeButton" Content="Trusted person: change the code..." Style="{StaticResource ChunkyButton}" Margin="0,0,10,0" Click="ChangeCode_Click" />
                                    <Button x:Name="TrustOffButton" Content="Turn off..." Style="{StaticResource ChunkyButton}" Click="TrustOff_Click" />
                                </WrapPanel>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource DangerCard}">
                            <TextBlock TextWrapping="Wrap" Foreground="{StaticResource NgRed}" FontWeight="SemiBold" LineHeight="21" FontSize="14">
                                WARNING: THERE IS NO WAY TO RECOVER A LOST CODE.<LineBreak />
                                The trusted person types the code in themselves, twice, and it is never shown, emailed or printed. This PC keeps only a scrambled copy. If they forget it, settings and uninstall stay locked for good.<LineBreak />
                                Wrong codes lock the code box for 15 minutes after 5 tries, and longer after each further try.<LineBreak /><LineBreak />
                                (NightGuard still never stops the PC working outside bedtime hours.)
                            </TextBlock>
                        </Border>
                    </StackPanel>
                </ScrollViewer>

                <!-- 8. Review -->
                <ScrollViewer x:Name="PageReview" Style="{StaticResource PageScroll}">
                    <StackPanel Style="{StaticResource PageBody}">
                        <local:PageHeader x:Name="HeadReview" Emoji="✅" EmojiColor="#C3F2DB" Title="Here's your night plan" Subtitle="Check it twice: once NightGuard is running, stricter changes are instant, but looser ones and uninstalling need a 7-day cool-off." />
                        <Border x:Name="ErrorCard" Style="{StaticResource DangerCard}" Visibility="Collapsed">
                            <StackPanel>
                                <TextBlock Text="⚠️  Please fix these first" Style="{StaticResource H2}" Foreground="{StaticResource NgRed}" />
                                <TextBlock x:Name="ErrorText" TextWrapping="Wrap" FontSize="14" LineHeight="21" />
                            </StackPanel>
                        </Border>
                        <Border x:Name="LooseCard" Style="{StaticResource Card}" BorderBrush="{StaticResource NgOrange}" Visibility="Collapsed">
                            <StackPanel>
                                <TextBlock x:Name="LooseTitle" Style="{StaticResource H2}" Foreground="{StaticResource NgOrange}" />
                                <TextBlock x:Name="LooseText" TextWrapping="Wrap" FontSize="14" LineHeight="21" />
                            </StackPanel>
                        </Border>
                        <WrapPanel x:Name="ReviewCards" />
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <CheckBox x:Name="DesktopCheck" Style="{StaticResource ToggleSwitch}" Content="Put a NightGuard shortcut on the desktop" />
                                <TextBlock Style="{StaticResource Hint}" Margin="58,4,0,0" Text="It's always in the Start Menu. Windows doesn't let apps pin themselves, so right-click it there and choose Pin to taskbar." />
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource Card}" BorderBrush="{StaticResource NgMoon}">
                            <CheckBox x:Name="ConfirmCheck" Style="{StaticResource ToggleSwitch}" Content="Yes, this is my plan. Let's do this! 💪" FontWeight="Bold" FontSize="17"
                                      Checked="ConfirmCheck_Changed" Unchecked="ConfirmCheck_Changed" />
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </DockPanel>
    </Grid>
</Window>
