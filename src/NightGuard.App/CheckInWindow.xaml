<Window x:Class="NightGuard.App.CheckInWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:NightGuard.App"
        Title="NightGuard - morning check-in" Width="600" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen" Icon="Assets/NightGuard.ico"
        Background="{StaticResource NgBg}" Foreground="{StaticResource NgText}" UseLayoutRounding="True">
    <DockPanel>
        <Border x:Name="Header" DockPanel.Dock="Top" Padding="24,18" ClipToBounds="True">
            <DockPanel>
                <local:Owl x:Name="Hoot" DockPanel.Dock="Left" Width="70" Height="76" Margin="0,0,18,0" />
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="GOOD MORNING" FontSize="11.5" FontWeight="Bold" Foreground="#E6FFFFFF" />
                    <TextBlock x:Name="TitleText" Foreground="White" FontSize="25" FontWeight="Bold" TextWrapping="Wrap" FontFamily="{StaticResource NgDisplay}" />
                </StackPanel>
            </DockPanel>
        </Border>
        <StackPanel Margin="24,18,24,22">
            <Border x:Name="BadgeCard" Visibility="Collapsed" Style="{StaticResource Card}" Padding="14,10">
                <StackPanel Orientation="Horizontal">
                    <Grid Width="58" Height="58" Margin="0,0,14,0">
                        <Ellipse Fill="#FFD666" Stroke="#E0A800" StrokeThickness="3" />
                        <TextBlock Text="&#x1F3C5;" FontFamily="Segoe UI Emoji" FontSize="28" Foreground="#8A5A00" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Grid>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="NEW BADGE UNLOCKED" Style="{StaticResource Overline}" />
                        <TextBlock x:Name="BadgeName" FontSize="19" FontWeight="Bold" />
                    </StackPanel>
                </StackPanel>
            </Border>
            <TextBlock x:Name="Body" FontSize="15" LineHeight="22" TextWrapping="Wrap" />
            <WrapPanel Margin="0,14,0,0">
                <Border Style="{StaticResource Card}" Padding="14,10" Margin="0,0,10,8">
                    <TextBlock x:Name="StreakText" FontSize="15" FontWeight="Bold" Foreground="{StaticResource NgOrange}" TextWrapping="Wrap" MaxWidth="230" />
                </Border>
                <Border x:Name="CommitCard" Style="{StaticResource Card}" Padding="14,10" Margin="0,0,0,8">
                    <StackPanel Orientation="Horizontal">
                        <Grid Width="40" Height="40" Margin="0,0,10,0">
                            <local:RingArc x:Name="CommitRing" Thickness="6" />
                        </Grid>
                        <TextBlock x:Name="CommitText" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center" TextWrapping="Wrap" MaxWidth="200" />
                    </StackPanel>
                </Border>
            </WrapPanel>
            <Border x:Name="CommitDone" Visibility="Collapsed" Style="{StaticResource Card}" BorderBrush="{StaticResource NgMoon}">
                <DockPanel>
                    <Button DockPanel.Dock="Right" Content="&#x1F3AF;  Commit again" Style="{StaticResource MoonButton}" Click="CommitAgain_Click" VerticalAlignment="Center" Margin="12,0,0,0" />
                    <TextBlock x:Name="CommitDoneText" TextWrapping="Wrap" FontSize="14" VerticalAlignment="Center" />
                </DockPanel>
            </Border>
            <TextBlock x:Name="WhyText" Style="{StaticResource SerifQuote}" FontSize="18" Margin="0,8,0,0" />
            <TextBlock Text="How are you feeling? (optional)" Style="{StaticResource Label}" Margin="0,18,0,8" />
            <UniformGrid x:Name="Moods" Columns="5" />
            <TextBlock Text="Three good things from yesterday (optional)" Style="{StaticResource Label}" Margin="0,16,0,2" />
            <TextBlock Style="{StaticResource Hint}" Margin="0,0,0,8" Text="Small is fine: a good match, a nice meal, a laugh. Stays private, on this PC." />
            <TextBox x:Name="Note" Style="{StaticResource JournalBox}" FontSize="16" MaxLength="280" MinHeight="80" AcceptsReturn="False"
                     Tag="1. ...   2. ...   3. ..." />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
                <Button Content="Save to my journal &#x1F4D3;" IsDefault="True" Margin="0,0,10,0" Click="Save_Click" Style="{StaticResource MoonButton}" />
                <Button Content="Skip" IsCancel="True" MinWidth="80" Style="{StaticResource ChunkyButton}" />
            </StackPanel>
        </StackPanel>
    </DockPanel>
</Window>
