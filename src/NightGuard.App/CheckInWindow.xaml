<Window x:Class="NightGuard.App.CheckInWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="NightGuard - morning check-in" Width="580" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen" Icon="Assets/NightGuard.ico">
    <DockPanel>
        <Border x:Name="Header" DockPanel.Dock="Top" Padding="22,18">
            <DockPanel>
                <TextBlock x:Name="HeaderEmoji" DockPanel.Dock="Left" FontFamily="Segoe UI Emoji" FontSize="40" Foreground="White" VerticalAlignment="Center" Margin="0,0,16,0" />
                <TextBlock x:Name="TitleText" Foreground="White" FontSize="23" FontWeight="Bold" TextWrapping="Wrap" VerticalAlignment="Center" />
            </DockPanel>
        </Border>
        <StackPanel Margin="22,16,22,20">
            <Border x:Name="BadgeCard" Visibility="Collapsed" CornerRadius="12" Padding="14,10" Margin="0,0,0,14">
                <StackPanel Orientation="Horizontal">
                    <Grid Width="58" Height="58" Margin="0,0,14,0">
                        <Ellipse Fill="#FFD666" Stroke="#E0A800" StrokeThickness="3" />
                        <TextBlock Text="&#x1F3C5;" FontFamily="Segoe UI Emoji" FontSize="28" Foreground="#8A5A00" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Grid>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="NEW BADGE UNLOCKED" FontSize="11" FontWeight="Bold" Foreground="White" Opacity="0.85" />
                        <TextBlock x:Name="BadgeName" FontSize="19" FontWeight="Bold" Foreground="White" />
                    </StackPanel>
                </StackPanel>
            </Border>
            <TextBlock x:Name="Body" FontSize="14" TextWrapping="Wrap" />
            <TextBlock x:Name="StreakText" FontSize="15" FontWeight="Bold" Foreground="{StaticResource NgOrange}" TextWrapping="Wrap" Margin="0,12,0,0" />
            <TextBlock x:Name="WhyText" FontSize="14" FontStyle="Italic" TextWrapping="Wrap" Margin="0,10,0,0" Foreground="{StaticResource NgAccent}" />
            <TextBlock Text="How are you feeling this morning? (optional)" FontWeight="SemiBold" Margin="0,18,0,8" />
            <UniformGrid x:Name="Moods" Columns="5" />
            <TextBlock Text="A short note for future you (optional, stays on this PC):" Margin="0,16,0,6" />
            <TextBox x:Name="Note" MaxLength="280" Height="64" TextWrapping="Wrap" AcceptsReturn="False" VerticalScrollBarVisibility="Auto" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
                <Button Content="Save to my journal &#x1F4D3;" IsDefault="True" Padding="16,8" Margin="0,0,10,0" Click="Save_Click"
                        Style="{DynamicResource AccentButtonStyle}" />
                <Button Content="Skip" IsCancel="True" Padding="16,8" MinWidth="80" />
            </StackPanel>
        </StackPanel>
    </DockPanel>
</Window>
