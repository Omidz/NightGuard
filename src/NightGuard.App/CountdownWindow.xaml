<Window x:Class="NightGuard.App.CountdownWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="NightGuard" Width="600" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen" ShowInTaskbar="True" Icon="Assets/NightGuard.ico"
        Background="#1E1E28" Foreground="White">
    <StackPanel Margin="30,26,30,26">
        <TextBlock x:Name="Prefix" FontSize="16" HorizontalAlignment="Center" Opacity="0.85" />
        <TextBlock x:Name="Seconds" FontSize="72" FontWeight="Bold" HorizontalAlignment="Center" Foreground="{StaticResource NgMoon}" />
        <TextBlock x:Name="Line" FontSize="18" TextWrapping="Wrap" TextAlignment="Center" HorizontalAlignment="Center" />
        <TextBlock x:Name="WhyText" FontSize="15" FontStyle="Italic" TextWrapping="Wrap" TextAlignment="Center" Margin="0,18,0,0" Opacity="0.9" />
        <TextBlock Text="Save your work now. Closing this window doesn't stop it." FontSize="12" Opacity="0.6"
                   HorizontalAlignment="Center" Margin="0,18,0,0" />
    </StackPanel>
</Window>
