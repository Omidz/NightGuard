<Window x:Class="NightGuard.App.CountdownWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:NightGuard.App"
        Title="NightGuard" Width="620" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen" ShowInTaskbar="True" Icon="Assets/NightGuard.ico" Foreground="White">
    <Grid x:Name="Root">
        <Canvas x:Name="Sky" IsHitTestVisible="False" ClipToBounds="True" />
        <StackPanel Margin="30,26,30,26">
            <Grid x:Name="MoonHolder" HorizontalAlignment="Center" Margin="0,0,0,6" />
            <TextBlock x:Name="Prefix" FontSize="18" FontWeight="SemiBold" HorizontalAlignment="Center" />
            <TextBlock x:Name="Seconds" FontSize="80" FontWeight="Bold" HorizontalAlignment="Center" Foreground="{StaticResource NgMoon}" />
            <TextBlock x:Name="Line" FontSize="18" TextWrapping="Wrap" TextAlignment="Center" HorizontalAlignment="Center" />
            <TextBlock x:Name="WhyText" FontSize="15" FontStyle="Italic" TextWrapping="Wrap" TextAlignment="Center" Margin="0,18,0,0" Opacity="0.9" />
            <TextBlock Text="&#x1F4BE; Save your work now. Closing this window doesn't stop it." FontSize="12.5" Opacity="0.7"
                       HorizontalAlignment="Center" Margin="0,18,0,0" />
        </StackPanel>
    </Grid>
</Window>
