<Window x:Class="NightGuard.App.JournalWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="NightGuard - my journal" Width="900" Height="620" MinWidth="600" MinHeight="400"
        WindowStartupLocation="CenterScreen" Icon="Assets/NightGuard.ico"
        xmlns:local="clr-namespace:NightGuard.App"
        Background="{StaticResource NgBg}" Foreground="{StaticResource NgText}" UseLayoutRounding="True">
    <DockPanel Margin="20">
        <StackPanel DockPanel.Dock="Top">
            <!-- The cover: your why, front and centre -->
            <Border Style="{StaticResource Card}" Background="{StaticResource NgSkyBrush}" Padding="22,18">
                <DockPanel>
                    <local:Owl DockPanel.Dock="Left" Width="72" Height="78" Margin="0,0,18,0" VerticalAlignment="Center" />
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="MY NIGHTGUARD JOURNAL" Style="{StaticResource Overline}" />
                        <TextBlock x:Name="WhyText" Style="{StaticResource SerifQuote}" FontSize="22" LineHeight="30" />
                        <TextBlock x:Name="PlanText" Style="{StaticResource Hint}" Margin="0,8,0,0" />
                    </StackPanel>
                </DockPanel>
            </Border>
            <TextBlock x:Name="Summary" FontWeight="SemiBold" FontSize="15" TextWrapping="Wrap" />
            <TextBlock x:Name="BadgeText" Foreground="{StaticResource NgOrange}" TextWrapping="Wrap" Margin="0,8,0,12" />
        </StackPanel>
        <DockPanel DockPanel.Dock="Bottom" Margin="0,12,0,0">
            <Button x:Name="ExportButton" Content="Save a copy..." Style="{StaticResource ChunkyButton}" Click="Export_Click" DockPanel.Dock="Left" />
            <Button Content="Close" IsCancel="True" Style="{StaticResource ChunkyButton}" MinWidth="90" DockPanel.Dock="Right" Click="Close_Click" />
            <TextBlock Text="Your journal is deleted when NightGuard is uninstalled, so save a copy if you want to keep it."
                       Style="{StaticResource Hint}" VerticalAlignment="Center" Margin="14,0" />
        </DockPanel>
        <Grid>
            <ListView x:Name="Entries">
                <ListView.View>
                    <GridView>
                        <GridViewColumn Header="Date" Width="140" DisplayMemberBinding="{Binding When}" />
                        <GridViewColumn Header="Mood" Width="90" DisplayMemberBinding="{Binding Mood}" />
                        <GridViewColumn Header="Last night" Width="150" DisplayMemberBinding="{Binding LastNight}" />
                        <GridViewColumn Header="Streak" Width="70" DisplayMemberBinding="{Binding Streak}" />
                        <GridViewColumn Header="Badge" Width="150" DisplayMemberBinding="{Binding Badge}" />
                        <GridViewColumn Header="Note" Width="320" DisplayMemberBinding="{Binding Note}" />
                    </GridView>
                </ListView.View>
            </ListView>
            <TextBlock x:Name="EmptyText" Text="Nothing here yet. Your morning check-ins will show up here." Margin="20"
                       HorizontalAlignment="Center" VerticalAlignment="Center" Style="{StaticResource Hint}" />
        </Grid>
    </DockPanel>
</Window>
