<Application x:Class="NightGuard.App.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Application.Resources>
        <ResourceDictionary>
            <!-- NightGuard's own colours; everything else follows the Windows theme (light or dark) -->
            <SolidColorBrush x:Key="NgIndigo" Color="#283278" />
            <SolidColorBrush x:Key="NgAccent" Color="#4655C8" />
            <SolidColorBrush x:Key="NgRed" Color="#C81E1E" />
            <SolidColorBrush x:Key="NgOrange" Color="#C2610A" />
            <SolidColorBrush x:Key="NgGreen" Color="#2E7D32" />
            <SolidColorBrush x:Key="NgSidebar" Color="#1C2034" />
            <SolidColorBrush x:Key="NgSidebarItem" Color="#C0C5DA" />
            <SolidColorBrush x:Key="NgMoon" Color="#FFD666" />
            <LinearGradientBrush x:Key="NgTipBrush" StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="#2A2466" Offset="0" />
                <GradientStop Color="#5A3E9E" Offset="1" />
            </LinearGradientBrush>

            <Style x:Key="PageTitle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="24" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="Margin" Value="0,0,0,6" />
                <Setter Property="TextWrapping" Value="Wrap" />
            </Style>
            <Style x:Key="Lead" TargetType="TextBlock">
                <Setter Property="FontSize" Value="14" />
                <Setter Property="TextWrapping" Value="Wrap" />
                <Setter Property="Margin" Value="0,0,0,14" />
            </Style>
            <Style x:Key="Hint" TargetType="TextBlock">
                <Setter Property="TextWrapping" Value="Wrap" />
                <Setter Property="Opacity" Value="0.72" />
                <Setter Property="Margin" Value="0,4,0,0" />
            </Style>
            <Style x:Key="Label" TargetType="TextBlock">
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="VerticalAlignment" Value="Center" />
                <Setter Property="Margin" Value="0,0,12,0" />
            </Style>
            <Style x:Key="Card" TargetType="Border">
                <Setter Property="Padding" Value="16" />
                <Setter Property="Margin" Value="0,0,0,12" />
                <Setter Property="CornerRadius" Value="8" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="BorderBrush" Value="{DynamicResource ControlStrokeColorDefaultBrush}" />
                <Setter Property="Background" Value="{DynamicResource CardBackgroundFillColorDefaultBrush}" />
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
