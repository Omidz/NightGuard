<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!--
        NightGuard's retro night-owl look. The app always uses the dark Windows 11 (Fluent) theme,
        recoloured here: deep navy sky, warm moonlight accent, cream text, chunky "sticker" cards.
        Keys defined here win over the Fluent theme's own keys.
    -->

    <!-- ============================================================ palette -->
    <Color x:Key="NgBgColor">#0E1230</Color>
    <Color x:Key="NgSurfaceColor">#181D45</Color>
    <Color x:Key="NgSurface2Color">#222960</Color>
    <Color x:Key="NgStrokeColor">#353D80</Color>
    <Color x:Key="NgShadowColor">#070A1E</Color>
    <Color x:Key="NgTextColor">#F6F0DD</Color>
    <Color x:Key="NgMutedColor">#AFB4DC</Color>
    <Color x:Key="NgMoonColor">#FFC94D</Color>
    <Color x:Key="NgMoonSoftColor">#FFDC85</Color>
    <Color x:Key="NgMoonDeepColor">#E0A52A</Color>
    <Color x:Key="NgOnMoonColor">#2A1D00</Color>

    <SolidColorBrush x:Key="NgBg" Color="{StaticResource NgBgColor}" />
    <SolidColorBrush x:Key="NgSurface" Color="{StaticResource NgSurfaceColor}" />
    <SolidColorBrush x:Key="NgSurface2" Color="{StaticResource NgSurface2Color}" />
    <SolidColorBrush x:Key="NgStroke" Color="{StaticResource NgStrokeColor}" />
    <SolidColorBrush x:Key="NgShadow" Color="{StaticResource NgShadowColor}" />
    <SolidColorBrush x:Key="NgText" Color="{StaticResource NgTextColor}" />
    <SolidColorBrush x:Key="NgMuted" Color="{StaticResource NgMutedColor}" />
    <SolidColorBrush x:Key="NgMoon" Color="{StaticResource NgMoonColor}" />
    <SolidColorBrush x:Key="NgMoonSoft" Color="{StaticResource NgMoonSoftColor}" />
    <SolidColorBrush x:Key="NgMoonDeep" Color="{StaticResource NgMoonDeepColor}" />
    <SolidColorBrush x:Key="NgOnMoon" Color="{StaticResource NgOnMoonColor}" />
    <SolidColorBrush x:Key="NgMoonGlow" Color="#26FFC94D" />
    <SolidColorBrush x:Key="NgPink" Color="#FF8AB4" />
    <SolidColorBrush x:Key="NgTeal" Color="#5FD8CB" />
    <SolidColorBrush x:Key="NgPurple" Color="#B49CFF" />

    <!-- Older names, still used here and there -->
    <SolidColorBrush x:Key="NgIndigo" Color="#2B2F7A" />
    <SolidColorBrush x:Key="NgAccent" Color="#9FAAFF" />
    <SolidColorBrush x:Key="NgRed" Color="#FF7070" />
    <SolidColorBrush x:Key="NgRedDeep" Color="#B3263A" />
    <SolidColorBrush x:Key="NgOrange" Color="#FFA25E" />
    <SolidColorBrush x:Key="NgGreen" Color="#62DB9F" />
    <SolidColorBrush x:Key="NgSidebar" Color="#0B0E27" />
    <LinearGradientBrush x:Key="NgTipBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#2A2466" Offset="0" />
        <GradientStop Color="#5A3E9E" Offset="1" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="NgSkyBrush" StartPoint="0,0" EndPoint="0.6,1">
        <GradientStop Color="#0C1030" Offset="0" />
        <GradientStop Color="#1E1A5A" Offset="0.6" />
        <GradientStop Color="#3E2A78" Offset="1" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="NgRetroBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#FF8AB4" Offset="0" />
        <GradientStop Color="#FFA25E" Offset="0.5" />
        <GradientStop Color="#FFC94D" Offset="1" />
    </LinearGradientBrush>

    <!-- ============================================================ Fluent overrides -->
    <Color x:Key="SystemAccentColor">#FFC94D</Color>
    <Color x:Key="SystemAccentColorLight1">#FFD470</Color>
    <Color x:Key="SystemAccentColorLight2">#FFDC85</Color>
    <Color x:Key="SystemAccentColorLight3">#FFE7AD</Color>
    <Color x:Key="SystemAccentColorDark1">#E0A52A</Color>
    <Color x:Key="SystemAccentColorDark2">#B98317</Color>
    <Color x:Key="SystemAccentColorDark3">#8A600C</Color>
    <SolidColorBrush x:Key="AccentFillColorDefaultBrush" Color="#FFC94D" />
    <SolidColorBrush x:Key="AccentFillColorSecondaryBrush" Color="#FFD470" />
    <SolidColorBrush x:Key="AccentFillColorTertiaryBrush" Color="#E0A52A" />
    <SolidColorBrush x:Key="AccentTextFillColorPrimaryBrush" Color="#FFDC85" />
    <SolidColorBrush x:Key="AccentTextFillColorSecondaryBrush" Color="#FFE7AD" />
    <SolidColorBrush x:Key="AccentTextFillColorTertiaryBrush" Color="#FFD470" />
    <Color x:Key="TextOnAccentFillColorPrimary">#2A1D00</Color>
    <SolidColorBrush x:Key="TextOnAccentFillColorPrimaryBrush" Color="#2A1D00" />
    <SolidColorBrush x:Key="AccentButtonBackground" Color="#FFC94D" />
    <SolidColorBrush x:Key="AccentButtonBackgroundPointerOver" Color="#FFD470" />
    <SolidColorBrush x:Key="AccentButtonBackgroundPressed" Color="#E0A52A" />
    <SolidColorBrush x:Key="AccentButtonForeground" Color="#2A1D00" />
    <SolidColorBrush x:Key="AccentButtonForegroundPointerOver" Color="#2A1D00" />
    <SolidColorBrush x:Key="AccentButtonForegroundPressed" Color="#3D2B00" />
    <SolidColorBrush x:Key="ApplicationBackgroundBrush" Color="{StaticResource NgBgColor}" />
    <SolidColorBrush x:Key="TextFillColorPrimaryBrush" Color="{StaticResource NgTextColor}" />
    <SolidColorBrush x:Key="TextFillColorSecondaryBrush" Color="{StaticResource NgMutedColor}" />
    <SolidColorBrush x:Key="CardBackgroundFillColorDefaultBrush" Color="{StaticResource NgSurfaceColor}" />
    <SolidColorBrush x:Key="LayerFillColorDefaultBrush" Color="{StaticResource NgSurfaceColor}" />

    <FontFamily x:Key="NgSerif">Sitka Display, Georgia, Cambria</FontFamily>
    <FontFamily x:Key="NgSerifText">Sitka Text, Georgia, Cambria</FontFamily>
    <FontFamily x:Key="NgDisplay">Segoe UI Variable Display, Segoe UI</FontFamily>
    <FontFamily x:Key="NgEmoji">Segoe UI Emoji</FontFamily>

    <!-- ============================================================ text -->
    <Style x:Key="H1" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource NgDisplay}" />
        <Setter Property="FontSize" Value="30" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="Foreground" Value="{StaticResource NgText}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
    <Style x:Key="H2" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource NgDisplay}" />
        <Setter Property="FontSize" Value="18" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{StaticResource NgText}" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="Margin" Value="0,0,0,6" />
    </Style>
    <Style x:Key="Overline" TargetType="TextBlock">
        <Setter Property="FontSize" Value="11.5" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="Foreground" Value="{StaticResource NgMoon}" />
        <Setter Property="Margin" Value="0,0,0,4" />
    </Style>
    <Style x:Key="SerifTitle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource NgSerif}" />
        <Setter Property="FontSize" Value="34" />
        <Setter Property="Foreground" Value="{StaticResource NgText}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
    <Style x:Key="SerifQuote" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource NgSerifText}" />
        <Setter Property="FontSize" Value="20" />
        <Setter Property="FontStyle" Value="Italic" />
        <Setter Property="Foreground" Value="{StaticResource NgMoonSoft}" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="LineHeight" Value="28" />
    </Style>
    <Style x:Key="PageTitle" TargetType="TextBlock" BasedOn="{StaticResource H1}" />
    <Style x:Key="Lead" TargetType="TextBlock">
        <Setter Property="FontSize" Value="15" />
        <Setter Property="LineHeight" Value="23" />
        <Setter Property="Foreground" Value="{StaticResource NgMuted}" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="Margin" Value="0,0,0,18" />
    </Style>
    <Style x:Key="Hint" TargetType="TextBlock">
        <Setter Property="FontSize" Value="13" />
        <Setter Property="LineHeight" Value="19" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="Foreground" Value="{StaticResource NgMuted}" />
        <Setter Property="Margin" Value="0,4,0,0" />
    </Style>
    <Style x:Key="Label" TargetType="TextBlock">
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="Foreground" Value="{StaticResource NgText}" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="Margin" Value="0,0,0,8" />
    </Style>

    <!-- ============================================================ cards -->
    <!-- The "sticker" card: a thick bottom edge gives it a chunky retro look without blurry effects -->
    <Style x:Key="Card" TargetType="Border">
        <Setter Property="Padding" Value="20,18" />
        <Setter Property="Margin" Value="0,0,0,16" />
        <Setter Property="CornerRadius" Value="16" />
        <Setter Property="BorderThickness" Value="2,2,2,5" />
        <Setter Property="BorderBrush" Value="{StaticResource NgStroke}" />
        <Setter Property="Background" Value="{StaticResource NgSurface}" />
    </Style>
    <Style x:Key="TileCard" TargetType="Border" BasedOn="{StaticResource Card}">
        <Setter Property="Margin" Value="0,0,16,16" />
        <Setter Property="Width" Value="300" />
        <Setter Property="VerticalAlignment" Value="Stretch" />
    </Style>
    <Style x:Key="DangerCard" TargetType="Border" BasedOn="{StaticResource Card}">
        <Setter Property="BorderBrush" Value="{StaticResource NgRed}" />
        <Setter Property="Background" Value="#2A1630" />
    </Style>
    <Style x:Key="IconBadge" TargetType="Border">
        <Setter Property="Width" Value="44" />
        <Setter Property="Height" Value="44" />
        <Setter Property="CornerRadius" Value="22" />
        <Setter Property="Background" Value="{StaticResource NgSurface2}" />
        <Setter Property="Margin" Value="0,0,12,0" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <!-- ============================================================ toggle switch (a CheckBox) -->
    <Style x:Key="ToggleSwitch" TargetType="CheckBox">
        <Setter Property="Foreground" Value="{StaticResource NgText}" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CheckBox">
                    <Grid Background="Transparent">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Border x:Name="Track" Width="46" Height="24" CornerRadius="12" BorderThickness="2" VerticalAlignment="Center"
                                BorderBrush="{StaticResource NgMuted}" Background="Transparent">
                            <Ellipse x:Name="Thumb" Width="14" Height="14" Fill="{StaticResource NgMuted}" HorizontalAlignment="Left" Margin="3,0,0,0" />
                        </Border>
                        <Border x:Name="Focus" Grid.Column="0" Width="52" Height="30" CornerRadius="15" BorderThickness="2" BorderBrush="{StaticResource NgMoonSoft}" Opacity="0" />
                        <ContentPresenter Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center" RecognizesAccessKey="True" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Track" Property="Background" Value="{StaticResource NgMoon}" />
                            <Setter TargetName="Track" Property="BorderBrush" Value="{StaticResource NgMoon}" />
                            <Setter TargetName="Thumb" Property="Fill" Value="{StaticResource NgOnMoon}" />
                            <Setter TargetName="Thumb" Property="Width" Value="16" />
                            <Setter TargetName="Thumb" Property="Height" Value="16" />
                            <Setter TargetName="Thumb" Property="HorizontalAlignment" Value="Right" />
                            <Setter TargetName="Thumb" Property="Margin" Value="0,0,2,0" />
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Track" Property="BorderBrush" Value="{StaticResource NgMoonSoft}" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Focus" Property="Opacity" Value="1" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.45" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ============================================================ pills (RadioButton or ToggleButton) -->
    <Style x:Key="Pill" TargetType="ToggleButton">
        <Setter Property="Foreground" Value="{StaticResource NgText}" />
        <Setter Property="Background" Value="{StaticResource NgSurface2}" />
        <Setter Property="BorderBrush" Value="{StaticResource NgStroke}" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Padding" Value="16,8" />
        <Setter Property="Margin" Value="0,0,8,8" />
        <Setter Property="MinWidth" Value="56" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <Border x:Name="B" CornerRadius="18" BorderThickness="2,2,2,4" Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}" Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" RecognizesAccessKey="True" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="B" Property="BorderBrush" Value="{StaticResource NgMoonSoft}" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="B" Property="BorderBrush" Value="{StaticResource NgMoonSoft}" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="B" Property="Background" Value="{StaticResource NgMoon}" />
                            <Setter TargetName="B" Property="BorderBrush" Value="{StaticResource NgMoonDeep}" />
                            <Setter Property="Foreground" Value="{StaticResource NgOnMoon}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.45" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- A big selectable card: the bedtime actions and the commitment choices -->
    <Style x:Key="ChoiceCard" TargetType="ToggleButton">
        <Setter Property="Foreground" Value="{StaticResource NgText}" />
        <Setter Property="Background" Value="{StaticResource NgSurface}" />
        <Setter Property="BorderBrush" Value="{StaticResource NgStroke}" />
        <Setter Property="Padding" Value="16,14" />
        <Setter Property="Margin" Value="0,0,14,14" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="VerticalContentAlignment" Value="Top" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <Grid>
                        <Border x:Name="B" CornerRadius="16" BorderThickness="2,2,2,5" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                        </Border>
                        <Border x:Name="Check" Width="26" Height="26" CornerRadius="13" Background="{StaticResource NgMoon}" Visibility="Collapsed"
                                HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,10,10,0">
                            <TextBlock Text="&#x2713;" Foreground="{StaticResource NgOnMoon}" FontWeight="Bold" FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="B" Property="BorderBrush" Value="{StaticResource NgMoonSoft}" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="B" Property="BorderBrush" Value="{StaticResource NgMoonSoft}" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="B" Property="BorderBrush" Value="{StaticResource NgMoon}" />
                            <Setter TargetName="B" Property="Background" Value="#2C2A5E" />
                            <Setter TargetName="Check" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.45" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ============================================================ buttons -->
    <Style x:Key="ChunkyButton" TargetType="Button">
        <Setter Property="Foreground" Value="{StaticResource NgText}" />
        <Setter Property="Background" Value="{StaticResource NgSurface2}" />
        <Setter Property="BorderBrush" Value="{StaticResource NgStroke}" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Padding" Value="18,10" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="B" CornerRadius="14" BorderThickness="2,2,2,5" Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}" Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" RecognizesAccessKey="True" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="B" Property="BorderBrush" Value="{StaticResource NgMoonSoft}" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="B" Property="BorderBrush" Value="{StaticResource NgMoonSoft}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="B" Property="BorderThickness" Value="2,3,2,2" />
                            <Setter TargetName="B" Property="Margin" Value="0,3,0,0" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.45" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="MoonButton" TargetType="Button" BasedOn="{StaticResource ChunkyButton}">
        <Setter Property="Background" Value="{StaticResource NgMoon}" />
        <Setter Property="BorderBrush" Value="{StaticResource NgMoonDeep}" />
        <Setter Property="Foreground" Value="{StaticResource NgOnMoon}" />
        <Setter Property="FontWeight" Value="Bold" />
    </Style>
    <Style x:Key="LinkButton" TargetType="Button">
        <Setter Property="Foreground" Value="{StaticResource NgMoon}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <TextBlock x:Name="T" Background="Transparent"><ContentPresenter RecognizesAccessKey="True" /></TextBlock>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="T" Property="TextDecorations" Value="Underline" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="T" Property="TextDecorations" Value="Underline" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <!-- Flat buttons in the sidebar -->
    <Style x:Key="SideButton" TargetType="Button">
        <Setter Property="Foreground" Value="{StaticResource NgMuted}" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="HorizontalContentAlignment" Value="Left" />
        <Setter Property="Padding" Value="12,8" />
        <Setter Property="Margin" Value="0,2" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="B" CornerRadius="10" Background="Transparent" Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="B" Property="Background" Value="{StaticResource NgSurface}" />
                            <Setter Property="Foreground" Value="{StaticResource NgText}" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="B" Property="Background" Value="{StaticResource NgSurface}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.4" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- The step list on the left -->
    <Style x:Key="StepItem" TargetType="ListBoxItem">
        <Setter Property="Foreground" Value="{StaticResource NgMuted}" />
        <Setter Property="FontSize" Value="14.5" />
        <Setter Property="Margin" Value="0,2" />
        <Setter Property="Padding" Value="10,9" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBoxItem">
                    <Border x:Name="B" CornerRadius="12" Background="Transparent" BorderThickness="2" BorderBrush="Transparent" Padding="{TemplateBinding Padding}">
                        <ContentPresenter VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="B" Property="Background" Value="{StaticResource NgSurface}" />
                            <Setter Property="Foreground" Value="{StaticResource NgText}" />
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="B" Property="Background" Value="{StaticResource NgSurface2}" />
                            <Setter TargetName="B" Property="BorderBrush" Value="{StaticResource NgMoon}" />
                            <Setter Property="Foreground" Value="{StaticResource NgText}" />
                            <Setter Property="FontWeight" Value="SemiBold" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="B" Property="BorderBrush" Value="{StaticResource NgMoonSoft}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ============================================================ text boxes -->
    <!-- The ritual's writing box: serif, roomy, with a dashed "paper" edge and a placeholder (Tag) -->
    <Style x:Key="JournalBox" TargetType="TextBox">
        <Setter Property="FontFamily" Value="{StaticResource NgSerifText}" />
        <Setter Property="FontSize" Value="19" />
        <Setter Property="Foreground" Value="{StaticResource NgText}" />
        <Setter Property="CaretBrush" Value="{StaticResource NgMoon}" />
        <Setter Property="SelectionBrush" Value="{StaticResource NgMoon}" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="Padding" Value="18,14" />
        <Setter Property="MinHeight" Value="64" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Grid>
                        <Rectangle x:Name="Edge" RadiusX="14" RadiusY="14" StrokeThickness="2" StrokeDashArray="4 3" Stroke="{StaticResource NgMuted}" Fill="#14FFFFFF" />
                        <TextBlock x:Name="Placeholder" Text="{TemplateBinding Tag}" Margin="20,14" FontStyle="Italic" Foreground="{StaticResource NgMuted}"
                                   Opacity="0.75" TextWrapping="Wrap" Visibility="Collapsed" IsHitTestVisible="False" />
                        <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}" VerticalScrollBarVisibility="Auto" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="Text" Value="">
                            <Setter TargetName="Placeholder" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Edge" Property="Stroke" Value="{StaticResource NgMoon}" />
                            <Setter TargetName="Edge" Property="StrokeDashArray" Value="{x:Null}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="Chip" TargetType="Button">
        <Setter Property="Foreground" Value="{StaticResource NgMoonSoft}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Margin" Value="0,0,8,8" />
        <Setter Property="Padding" Value="12,6" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="B" CornerRadius="14" BorderThickness="1.5" BorderBrush="#55FFC94D" Background="#14FFC94D" Padding="{TemplateBinding Padding}">
                        <ContentPresenter />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="B" Property="Background" Value="#33FFC94D" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="B" Property="BorderBrush" Value="{StaticResource NgMoon}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
