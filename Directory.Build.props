<Project>
  <PropertyGroup>
    <Version>2.0.0</Version>
    <Authors>Omid</Authors>
    <Company>NightGuard</Company>
    <Product>NightGuard</Product>
    <Copyright>Copyright (c) Omid. PolyForm Strict License 1.0.0.</Copyright>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <!-- Lets the Windows projects compile on Linux/macOS (CI and development); they only run on Windows. -->
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
  </PropertyGroup>
</Project>
