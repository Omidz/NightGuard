<Project Sdk="WixToolset.Sdk/5.0.2">
  <!--
    Builds NightGuard.msi from the published app and service (see .github/workflows/build.yml):
      dotnet build installer/NightGuard.Installer.wixproj -c Release -p:PublishDir=<folder with NightGuard.exe and NightGuard.Service.exe>
    Windows only (WiX needs Windows).
  -->
  <PropertyGroup>
    <OutputName>NightGuard</OutputName>
    <OutputType>Package</OutputType>
    <Platform>x64</Platform>
    <InstallerPlatform>x64</InstallerPlatform>
    <PublishDir Condition="'$(PublishDir)' == ''">..\out\publish\</PublishDir>
    <ProductVersion Condition="'$(ProductVersion)' == ''">2.0.0</ProductVersion>
    <DefineConstants>PublishDir=$(PublishDir);ProductVersion=$(ProductVersion)</DefineConstants>
    <SuppressValidation>false</SuppressValidation>
    <!-- ICE43/ICE57 assume Start Menu shortcuts are per-user; this package is per-machine (ALLUSERS=1), where they are false alarms. -->
    <SuppressIces>ICE43;ICE57</SuppressIces>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="WixToolset.Util.wixext" Version="5.0.2" />
    <PackageReference Include="WixToolset.UI.wixext" Version="5.0.2" />
  </ItemGroup>
</Project>
